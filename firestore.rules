rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'friendsCount', 'likesReceived', 'matchCount', 'blockedUsers'])
      );
      allow delete: if false;

      match /following/{targetUid} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /followers/{followerUid} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == followerUid;
      }

      match /friends/{friendUid} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || (isAuthenticated() && request.auth.uid == friendUid);
      }

      match /friendRequests/{reqId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.uid != null);

      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /reactions/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // Dating Profiles & Matches
    match /datingProfiles/{profileId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /matchProfiles/{profileId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /matchLikes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.fromUserId == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.userIds);
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.userIds;
      allow update, delete: if isAuthenticated() && request.auth.uid in resource.data.userIds;
    }

    // Communities
    match /communities/{communityId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /members/{memberId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == memberId;
      }
    }

    // Chats and Messages
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Safety Reports
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    // Verification Requests
    match /verificationRequests/{reqId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Transactions (owner only audit log, immutable)
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}


